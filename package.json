    "configuration": {
      "title": "Command Center for Claude Code",
      "properties": {
        "claudeCommandCenter.autoOpenBackground": {
          "type": "boolean",
          "default": true,
          "description": "Open a terminal tab with live logs whenever Claude starts a background process (dev server, watcher, …)."
        },
        "claudeCommandCenter.autoOpenForeground": {
          "type": "boolean",
          "default": true,
          "description": "Open a terminal tab whenever Claude starts a regular (foreground) command. Its output appears when the command finishes."
        },
        "claudeCommandCenter.scope": {
          "type": "string",
          "enum": [
            "workspace",
            "all"
          ],
          "enumDescriptions": [
            "Only commands that ran inside this window's workspace folders",
            "Commands from every Claude session on this machine"
          ],
          "default": "workspace",
          "description": "Default for which commands each VS Code window shows. The dashboard toggle overrides it per workspace."
        },
        "claudeCommandCenter.retentionDays": {
          "type": "number",
          "default": 7,
          "minimum": 0,
          "description": "Delete the before/after snapshots of Claude's file edits after this many days. 0 keeps them forever. Diffs of older changes stop working once their snapshots are gone."
        },
        "claudeCommandCenter.chatFileRetentionHours": {
          "type": "number",
          "default": 24,
          "minimum": 0,
          "description": "Delete the files made for \"Add to Claude Chat\" (terminal selections, command output) after this many hours. Keep it long enough for Claude to read them: the file is read when the message is sent. 0 keeps them forever."
        },
        "claudeCommandCenter.maxItems": {
          "type": "number",
          "default": 200,
          "description": "Maximum number of commands shown in the list."
        },
        "claudeCommandCenter.logDir": {
          "type": "string",
          "default": "",
          "description": "Folder the hook writes events.jsonl to. Empty = ~/.claude/command-center/log."
        },
        "claudeCommandCenter.notifyTurnEnd": {
          "type": "string",
          "enum": [
            "always",
            "unfocused",
            "never"
          ],
          "enumDescriptions": [
            "Always",
            "Only when this VS Code window is not focused",
            "Never"
          ],
          "default": "unfocused",
          "description": "Notify when Claude finishes a turn and waits for you, in a project open in this window."
        },
        "claudeCommandCenter.notifyAttention": {
          "type": "string",
          "enum": [
            "always",
            "unfocused",
            "never"
          ],
          "enumDescriptions": [
            "Always",
            "Only when this VS Code window is not focused",
            "Never"
          ],
          "default": "unfocused",
          "description": "Notify when Claude needs permission or an answer before it can continue."
        },
        "claudeCommandCenter.notifySubagentEnd": {
          "type": "string",
          "enum": [
            "always",
            "unfocused",
            "never"
          ],
          "enumDescriptions": [
            "Always",
            "Only when this VS Code window is not focused",
            "Never"
          ],
          "default": "never",
          "description": "Notify when a subagent finishes."
        },
        "claudeCommandCenter.notifySubagentMinSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "description": "Only notify about subagents that ran at least this many seconds."
        },
        "claudeCommandCenter.showUsage": {
          "type": "boolean",
          "default": true,
          "description": "Show the tokens Claude Code used in the last 5 hours in the status bar (counted from local transcripts; hover for today and 7 days)."
        },
        "claudeCommandCenter.sessionDays": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "List Claude Code sessions active in the last this many days."
        },
        "claudeCommandCenter.notifyServerUrl": {
          "type": "string",
          "enum": [
            "always",
            "unfocused",
            "never"
          ],
          "enumDescriptions": [
            "Always",
            "Only when this VS Code window is not focused",
            "Never"
          ],
          "default": "always",
          "description": "Offer to open a dev server when a background process Claude started prints a local URL (http://localhost:…)."
        },
        "claudeCommandCenter.answerPermissions": {
          "type": "boolean",
          "default": false,
