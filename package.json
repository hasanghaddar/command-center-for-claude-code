{
  "name": "command-center-for-claude-code",
  "displayName": "Command Center for Claude Code",
  "description": "Watch, control and feed context to Claude Code: live commands and logs, diffs of every edit, stop background processes, and @-mention files, selections and terminal output. Unofficial; not affiliated with Anthropic.",
  "version": "0.8.2",
  "publisher": "hynexia",
  "author": {
    "name": "Hynexia",
    "email": "info@hynexia.net",
    "url": "https://hynexia.net"
  },
  "homepage": "https://github.com/hasanghaddar/command-center-for-claude-code#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/hasanghaddar/command-center-for-claude-code.git"
  },
  "bugs": {
    "url": "https://github.com/hasanghaddar/command-center-for-claude-code/issues",
    "email": "info@hynexia.net"
  },
  "icon": "media/logo.png",
  "galleryBanner": {
    "color": "#1A2B4D",
    "theme": "dark"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "ai",
    "agent",
    "process monitor",
    "command center",
    "terminal",
    "diff",
    "logs",
    "hooks"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeCommandCenter",
          "title": "Command Center",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claudeCommandCenter": [
        {
          "id": "claudeCommandCenter.commands",
          "name": "Commands",
          "icon": "media/icon.svg"
        },
        {
          "id": "claudeCommandCenter.changes",
          "name": "File Changes",
          "icon": "media/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "claudeCommandCenter.commands",
        "contents": "No commands recorded yet.\n\n[Set up hooks](command:claudeCommandCenter.setup)\n\nThen start a new Claude Code session and let Claude run a command.\n[Open dashboard](command:claudeCommandCenter.dashboard)\n[Open live feed](command:claudeCommandCenter.openFeed)"
      },
      {
        "view": "claudeCommandCenter.changes",
        "contents": "No file changes recorded yet.\n\nEvery file Claude edits shows up here, with a diff.\n[Set up hooks](command:claudeCommandCenter.setup)"
      }
    ],
    "commands": [
      {
        "command": "claudeCommandCenter.open",
        "title": "Show Output",
        "icon": "$(terminal)"
      },
      {
        "command": "claudeCommandCenter.dashboard",
        "title": "Command Center: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "claudeCommandCenter.openFeed",
        "title": "Command Center: Open Live Feed",
        "icon": "$(pulse)"
      },
      {
        "command": "claudeCommandCenter.toggleScope",
        "title": "Command Center: Toggle This Workspace / All Workspaces",
        "icon": "$(filter)"
      },
      {
        "command": "claudeCommandCenter.copyCommand",
        "title": "Copy Command",
        "icon": "$(copy)"
      },
      {
        "command": "claudeCommandCenter.runInTerminal",
        "title": "Run Again in My Terminal",
        "icon": "$(play)"
      },
      {
        "command": "claudeCommandCenter.stop",
        "title": "Stop Process",
        "icon": "$(debug-stop)"
      },
      {
        "command": "claudeCommandCenter.openChangeDiff",
        "title": "Open Diff",
        "icon": "$(diff)"
      },
      {
        "command": "claudeCommandCenter.compareWithCurrent",
        "title": "Compare Before-Edit With Current File",
        "icon": "$(compare-changes)"
      },
      {
        "command": "claudeCommandCenter.openChangedFile",
        "title": "Open File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "claudeCommandCenter.addToChat",
        "title": "Add to Claude Chat",
        "icon": "$(mention)"
      },
      {
        "command": "claudeCommandCenter.addSelectionToChat",
        "title": "Add Selection to Claude Chat",
        "icon": "$(mention)"
      },
      {
        "command": "claudeCommandCenter.setup",
        "title": "Command Center: Set Up Hooks"
      },
      {
        "command": "claudeCommandCenter.removeHooks",
        "title": "Command Center: Remove Hooks"
      },
      {
        "command": "claudeCommandCenter.addTerminalToChat",
        "title": "Add to Claude Chat (selection, or last command output)",
        "icon": "$(mention)"
      },
      {
        "command": "claudeCommandCenter.addTerminalSelectionToChat",
        "title": "Add Terminal Selection to Claude Chat",
        "icon": "$(mention)"
      },
      {
        "command": "claudeCommandCenter.addTerminalLastOutputToChat",
        "title": "Add Last Command Output to Claude Chat",
        "icon": "$(mention)"
      },
      {
        "command": "claudeCommandCenter.addChangeToChat",
        "title": "Add to Claude Chat",
        "icon": "$(mention)"
      },
      {
        "command": "claudeCommandCenter.addCommandToChat",
        "title": "Add Command and Output to Claude Chat",
        "icon": "$(mention)"
      },
      {
        "command": "claudeCommandCenter.clear",
        "title": "Command Center: Clear History",
        "icon": "$(clear-all)"
      },
      {
        "command": "claudeCommandCenter.refresh",
        "title": "Command Center: Refresh",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "claudeCommandCenter.addToChat",
          "group": "claude@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "claudeCommandCenter.addToChat",
          "when": "resourceScheme == file",
          "group": "claude@1"
        }
      ],
      "editor/context": [
        {
          "command": "claudeCommandCenter.addSelectionToChat",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "claude@1"
        },
        {
          "command": "claudeCommandCenter.addToChat",
          "when": "!editorHasSelection && resourceScheme == file",
          "group": "claude@1"
        }
      ],
      "terminal/context": [
        {
          "command": "claudeCommandCenter.addTerminalSelectionToChat",
          "when": "terminalTextSelected",
          "group": "claude@1"
        },
        {
          "command": "claudeCommandCenter.addTerminalLastOutputToChat",
          "group": "claude@2"
        }
      ],
      "terminal/title/context": [
        {
          "command": "claudeCommandCenter.addTerminalLastOutputToChat",
          "group": "claude@1"
        }
      ],
      "view/title": [
        {
          "command": "claudeCommandCenter.addTerminalToChat",
          "when": "view == terminal",
          "group": "navigation@0"
        },
        {
          "command": "claudeCommandCenter.dashboard",
          "when": "view == claudeCommandCenter.commands",
          "group": "navigation@0"
        },
        {
          "command": "claudeCommandCenter.openFeed",
          "when": "view == claudeCommandCenter.commands",
          "group": "navigation@1"
        },
        {
          "command": "claudeCommandCenter.toggleScope",
          "when": "view == claudeCommandCenter.commands",
          "group": "navigation@2"
        },
        {
          "command": "claudeCommandCenter.refresh",
          "when": "view == claudeCommandCenter.commands",
          "group": "navigation@2"
        },
        {
          "command": "claudeCommandCenter.clear",
          "when": "view == claudeCommandCenter.commands",
          "group": "navigation@3"
        },
        {
          "command": "claudeCommandCenter.toggleScope",
          "when": "view == claudeCommandCenter.changes",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeCommandCenter.stop",
          "when": "view == claudeCommandCenter.commands && viewItem == proc.background",
          "group": "inline@1"
        },
        {
          "command": "claudeCommandCenter.open",
          "when": "view == claudeCommandCenter.commands",
          "group": "inline@2"
        },
        {
          "command": "claudeCommandCenter.copyCommand",
          "when": "view == claudeCommandCenter.commands",
          "group": "1_actions@1"
        },
        {
          "command": "claudeCommandCenter.runInTerminal",
          "when": "view == claudeCommandCenter.commands",
          "group": "1_actions@2"
        },
        {
          "command": "claudeCommandCenter.stop",
          "when": "view == claudeCommandCenter.commands && viewItem == proc.background",
          "group": "1_actions@3"
        },
        {
          "command": "claudeCommandCenter.addCommandToChat",
          "when": "view == claudeCommandCenter.commands",
          "group": "1_actions@0"
        },
        {
          "command": "claudeCommandCenter.addChangeToChat",
          "when": "view == claudeCommandCenter.changes",
          "group": "inline@0"
        },
        {
          "command": "claudeCommandCenter.addChangeToChat",
          "when": "view == claudeCommandCenter.changes",
          "group": "1_actions@0"
        },
        {
          "command": "claudeCommandCenter.compareWithCurrent",
          "when": "view == claudeCommandCenter.changes",
          "group": "inline@1"
        },
        {
          "command": "claudeCommandCenter.openChangedFile",
          "when": "view == claudeCommandCenter.changes",
          "group": "inline@2"
        },
        {
          "command": "claudeCommandCenter.openChangeDiff",
          "when": "view == claudeCommandCenter.changes",
          "group": "1_actions@1"
        },
        {
          "command": "claudeCommandCenter.compareWithCurrent",
          "when": "view == claudeCommandCenter.changes",
          "group": "1_actions@2"
        },
        {
          "command": "claudeCommandCenter.openChangedFile",
          "when": "view == claudeCommandCenter.changes",
          "group": "1_actions@3"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeCommandCenter.open",
          "when": "false"
        },
        {
          "command": "claudeCommandCenter.copyCommand",
          "when": "false"
        },
        {
          "command": "claudeCommandCenter.runInTerminal",
          "when": "false"
        },
        {
          "command": "claudeCommandCenter.stop",
          "when": "false"
        },
        {
          "command": "claudeCommandCenter.openChangeDiff",
          "when": "false"
        },
        {
          "command": "claudeCommandCenter.compareWithCurrent",
          "when": "false"
        },
        {
          "command": "claudeCommandCenter.openChangedFile",
          "when": "false"
        },
        {
          "command": "claudeCommandCenter.addChangeToChat",
          "when": "false"
        },
        {
          "command": "claudeCommandCenter.addCommandToChat",
          "when": "false"
        },
        {
          "command": "claudeCommandCenter.addSelectionToChat",
          "when": "editorHasSelection"
        },
        {
          "command": "claudeCommandCenter.addTerminalSelectionToChat",
          "when": "terminalFocus && terminalTextSelected"
        },
        {
          "command": "claudeCommandCenter.addTerminalLastOutputToChat",
          "when": "terminalFocus"
        }
      ]
    },
    "keybindings": [
      {
        "command": "claudeCommandCenter.addTerminalSelectionToChat",
        "key": "alt+k",
        "mac": "alt+k",
        "when": "terminalFocus && terminalTextSelected"
      }
    ],
    "configuration": {
      "title": "Command Center for Claude Code",
      "properties": {
        "claudeCommandCenter.autoOpenBackground": {
          "type": "boolean",
          "default": true,
          "description": "Open a terminal tab with live logs whenever Claude starts a background process (dev server, watcher, …)."
        },
        "claudeCommandCenter.scope": {
          "type": "string",
          "enum": [
            "workspace",
            "all"
          ],
          "enumDescriptions": [
            "Only commands that ran inside this window's workspace folders",
            "Commands from every Claude session on this machine"
          ],
          "default": "workspace",
          "description": "Default for which commands each VS Code window shows. The dashboard toggle overrides it per workspace."
        },
        "claudeCommandCenter.retentionDays": {
          "type": "number",
          "default": 7,
          "minimum": 0,
          "description": "Delete the before/after snapshots of Claude's file edits after this many days. 0 keeps them forever. Diffs of older changes stop working once their snapshots are gone."
        },
        "claudeCommandCenter.chatFileRetentionHours": {
          "type": "number",
          "default": 24,
          "minimum": 0,
          "description": "Delete the files made for \"Add to Claude Chat\" (terminal selections, command output) after this many hours. Keep it long enough for Claude to read them: the file is read when the message is sent. 0 keeps them forever."
        },
        "claudeCommandCenter.maxItems": {
          "type": "number",
          "default": 200,
          "description": "Maximum number of commands shown in the list."
        },
        "claudeCommandCenter.logDir": {
          "type": "string",
          "default": "",
          "description": "Folder the hook writes events.jsonl to. Empty = ~/.claude/command-center/log."
        }
      }
    }
  },
  "scripts": {
    "vscode:uninstall": "node ./uninstall.js",
    "package": "npx --yes @vscode/vsce package",
    "publish:vscode": "npx --yes @vscode/vsce publish",
    "publish:openvsx": "npx --yes ovsx publish"
  }
}
