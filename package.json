{
  "name": "command-center-for-claude-code",
  "displayName": "Command Center for Claude Code",
  "description": "Watch, control and feed context to Claude Code: live commands and logs, diffs of every edit, stop background processes, sessions you can resume or move between projects, notifications, token usage, and @-mention files, selections and terminal output. Unofficial; not affiliated with Anthropic.",
  "version": "0.11.1",
  "publisher": "hynexia",
  "author": {
    "name": "Hynexia",
    "email": "info@hynexia.net",
    "url": "https://hynexia.net"
  },
  "homepage": "https://github.com/hasanghaddar/command-center-for-claude-code#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/hasanghaddar/command-center-for-claude-code.git"
  },
  "bugs": {
    "url": "https://github.com/hasanghaddar/command-center-for-claude-code/issues",
    "email": "info@hynexia.net"
  },
  "icon": "media/logo.png",
  "galleryBanner": {
    "color": "#1A2B4D",
    "theme": "dark"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "ai",
    "agent",
    "process monitor",
    "command center",
    "terminal",
    "diff",
    "logs",
    "hooks",
    "sessions",
    "usage",
    "notifications",
    "transcript"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeCommandCenter",
          "title": "Command Center",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claudeCommandCenter": [
        {
          "id": "claudeCommandCenter.commands",
          "name": "Commands",
          "icon": "media/icon.svg"
        },
        {
          "id": "claudeCommandCenter.changes",
          "name": "File Changes",
          "icon": "media/icon.svg"
        },
        {
          "id": "claudeCommandCenter.sessions",
          "name": "Sessions",
          "icon": "media/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "claudeCommandCenter.commands",
        "contents": "No commands recorded yet.\n\n[Set up hooks](command:claudeCommandCenter.setup)\n\nThen start a new Claude Code session and let Claude run a command.\n[Open dashboard](command:claudeCommandCenter.dashboard)\n[Open live feed](command:claudeCommandCenter.openFeed)"
      },
      {
        "view": "claudeCommandCenter.changes",
        "contents": "No file changes recorded yet.\n\nEvery file Claude edits shows up here, with a diff.\n[Set up hooks](command:claudeCommandCenter.setup)"
      },
      {
        "view": "claudeCommandCenter.sessions",
        "contents": "No Claude Code sessions in the last 30 days for this workspace.\n\nSessions are read from ~/.claude/projects."
      }
    ],
